<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="AgapeApp.Mobile.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:AgapeApp.Mobile.Views"
    Title="AgapeApp"
    FlyoutBehavior="Disabled"
    BackgroundColor="{StaticResource Superficie}"
    TabBarBackgroundColor="{StaticResource Superficie}"
    TabBarForegroundColor="{StaticResource Primary}"
    TabBarTitleColor="{StaticResource Primary}"
    TabBarUnselectedColor="{StaticResource TextoSecundario}">

    <Shell.Resources>
        <!-- Ícones Font Awesome (fa-solid-900.ttf): calendário, engrenagens e usuário -->
        <FontImageSource x:Key="IconeEventos" FontFamily="fa" Glyph="&#xf073;" Size="20" Color="#64748B" />
        <FontImageSource x:Key="IconeGestao" FontFamily="fa" Glyph="&#xf085;" Size="20" Color="#64748B" />
        <FontImageSource x:Key="IconePerfil" FontFamily="fa" Glyph="&#xf007;" Size="20" Color="#64748B" />
    </Shell.Resources>

    <!-- Tela de entrada; após o login o app vai para //principal -->
    <ShellContent
        Route="login"
        ContentTemplate="{DataTemplate views:LoginPage}"
        FlyoutItemIsVisible="False" />

    <!-- Área autenticada: abas Eventos, Gestão (só administrador) e Perfil -->
    <TabBar Route="principal">
        <ShellContent
            Title="Eventos"
            Route="eventos"
            Icon="{StaticResource IconeEventos}"
            ContentTemplate="{DataTemplate views:MeusEventosPage}" />
        <!-- A aba Gestão só aparece para administradores (ver AjustarAbasPorPerfil). -->
        <ShellContent
            x:Name="AbaGestao"
            Title="Gestão"
            Route="gestao"
            Icon="{StaticResource IconeGestao}"
            ContentTemplate="{DataTemplate views:GestaoPage}" />
        <ShellContent
            Title="Perfil"
            Route="perfil"
            Icon="{StaticResource IconePerfil}"
            ContentTemplate="{DataTemplate views:PerfilPage}" />
    </TabBar>

</Shell>
