<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgapeApp.Mobile.Views.UsuarioFormPage"
             Title="Usuário"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="16">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Start"
                        Stroke="{StaticResource Borda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Superficie}">
                    <Label Text="&#xf060;" FontFamily="fa" FontSize="15"
                           TextColor="{StaticResource TextoPrimario}"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloMedio}" />
                    <Label Text="{Binding Subtitulo}" Style="{StaticResource LegendaPequena}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nome completo" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Text="&#xf007;" FontFamily="fa" FontSize="16"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Nome}"
                                       Placeholder="Ex.: Maria Souza" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="E-mail" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Text="&#xf0e0;" FontFamily="fa" FontSize="16"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Email}"
                                       Keyboard="Email"
                                       Placeholder="nome@paroquia.com" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding MostrarSenha}">
                        <Label Text="Senha inicial" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Text="&#xf023;" FontFamily="fa" FontSize="16"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Senha}"
                                       IsPassword="True"
                                       Placeholder="Pelo menos 8 caracteres" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Perfil de acesso" Style="{StaticResource Legenda}" />
                        <Border BackgroundColor="{StaticResource CinzaContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="4">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">

                                <Border Padding="10,9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 9"
                                        BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Administrador}" Value="False">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Operador"
                                           HorizontalTextAlignment="Center"
                                           FontFamily="InterMedium"
                                           FontSize="13"
                                           TextColor="{StaticResource TextoSecundario}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Administrador}" Value="False">
                                                <Setter Property="FontFamily" Value="InterSemiBold" />
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DefinirPerfilCommand}" CommandParameter="Operador" />
                                    </Border.GestureRecognizers>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="10,9"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 9"
                                        BackgroundColor="Transparent">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Administrador}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Superficie}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="Administrador"
                                           HorizontalTextAlignment="Center"
                                           FontFamily="InterMedium"
                                           FontSize="13"
                                           TextColor="{StaticResource TextoSecundario}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Administrador}" Value="True">
                                                <Setter Property="FontFamily" Value="InterSemiBold" />
                                                <Setter Property="TextColor" Value="{StaticResource Primary}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding DefinirPerfilCommand}" CommandParameter="Administrador" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                        </Border>
                        <Label Text="O administrador cuida dos cadastros e enxerga todos os eventos; o operador só opera os setores em que for designado."
                               Style="{StaticResource LegendaPequena}" />
                    </VerticalStackLayout>

                    <!-- Erro -->
                    <Border IsVisible="{Binding TemErro}"
                            BackgroundColor="{StaticResource PerigoContainer}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                            <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                                   TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MensagemErro}"
                                   Style="{StaticResource Corpo}"
                                   TextColor="{StaticResource OnPerigoContainer}" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Button Text="{Binding TextoBotao}" Command="{Binding SalvarCommand}" />
                        <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                           IsRunning="{Binding EstaCarregando}"
                                           Color="{StaticResource Superficie}"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,18,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
