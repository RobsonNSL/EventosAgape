<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgapeApp.Mobile.Views.GestaoPage"
             Title="Gestão"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="14">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="2">
                <Label Text="Gestão" Style="{StaticResource TituloGrande}" />
                <Label Text="Área do administrador: cadastros e preparação dos eventos" Style="{StaticResource Legenda}" />
            </VerticalStackLayout>

            <!-- Usuários -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="44,*,20" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource PrimaryContainer}"
                            VerticalOptions="Center">
                        <Label Text="&#xf0c0;" FontFamily="fa" FontSize="16"
                               TextColor="{StaticResource OnPrimaryContainer}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Usuários" Style="{StaticResource SubtituloPequeno}" />
                        <Label Text="Equipe, perfis e senhas" Style="{StaticResource LegendaPequena}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xf054;" FontFamily="fa" FontSize="13"
                           TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirUsuariosCommand}" />
                    </Border.GestureRecognizers>
                </Grid>
            </Border>

            <!-- Produtos -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="44,*,20" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SucessoContainer}"
                            VerticalOptions="Center">
                        <Label Text="&#xf1b2;" FontFamily="fa" FontSize="16"
                               TextColor="{StaticResource OnSucessoContainer}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Produtos" Style="{StaticResource SubtituloPequeno}" />
                        <Label Text="Catálogo de tudo o que o evento vende" Style="{StaticResource LegendaPequena}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xf054;" FontFamily="fa" FontSize="13"
                           TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirProdutosCommand}" />
                    </Border.GestureRecognizers>
                </Grid>
            </Border>

            <!-- Eventos -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="44,*,20" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource DestaqueContainer}"
                            VerticalOptions="Center">
                        <Label Text="&#xf073;" FontFamily="fa" FontSize="16"
                               TextColor="{StaticResource OnDestaqueContainer}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Eventos" Style="{StaticResource SubtituloPequeno}" />
                        <Label Text="Setores, produtos e operadores de cada evento" Style="{StaticResource LegendaPequena}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xf054;" FontFamily="fa" FontSize="13"
                           TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirEventosCommand}" />
                    </Border.GestureRecognizers>
                </Grid>
            </Border>

            <!-- Cartões -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="44,*,20" ColumnSpacing="12">
                    <Border WidthRequest="40" HeightRequest="40"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource PerigoContainer}"
                            VerticalOptions="Center">
                        <Label Text="&#xf09d;" FontFamily="fa" FontSize="16"
                               TextColor="{StaticResource OnPerigoContainer}"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Cartões" Style="{StaticResource SubtituloPequeno}" />
                        <Label Text="Cadastro e ativação dos cartões pré-pagos" Style="{StaticResource LegendaPequena}" />
                    </VerticalStackLayout>
                    <Label Grid.Column="2" Text="&#xf054;" FontFamily="fa" FontSize="13"
                           TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AbrirCartoesCommand}" />
                    </Border.GestureRecognizers>
                </Grid>
            </Border>

            <!-- Dica -->
            <Border BackgroundColor="{StaticResource SuperficieTint}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf05a;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Para o operador conseguir vender, o evento precisa estar aberto, com setor, produtos vinculados ao setor e operador designado."
                           Style="{StaticResource LegendaPequena}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
