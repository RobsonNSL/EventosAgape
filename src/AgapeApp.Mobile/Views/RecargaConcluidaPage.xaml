<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgapeApp.Mobile.Views.RecargaConcluidaPage"
             Title="Recarga concluída"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="14">

            <Border WidthRequest="88"
                    HeightRequest="88"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 44"
                    BackgroundColor="{StaticResource SucessoContainer}"
                    HorizontalOptions="Center">
                <Label Text="&#xf00c;" FontFamily="fa" FontSize="34"
                       TextColor="{StaticResource Sucesso}"
                       HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>

            <Label Text="Recarga concluída!"
                   Style="{StaticResource TituloMedio}"
                   HorizontalTextAlignment="Center"
                   Margin="0,6,0,0" />

            <Label Text="{Binding TextoValor}"
                   Style="{StaticResource ValorGrande}"
                   TextColor="{StaticResource Sucesso}"
                   HorizontalTextAlignment="Center" />

            <Label Text="{Binding TextoCartao}"
                   Style="{StaticResource LegendaPequena}"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,8" />

            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Novo saldo no evento"
                           Style="{StaticResource Legenda}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding TextoSaldo}"
                           Style="{StaticResource ValorMedio}"
                           TextColor="{StaticResource Sucesso}" />
                </Grid>
            </Border>

            <Button Text="Recarregar outro cartão"
                    Style="{StaticResource BotaoDestaque}"
                    Command="{Binding RecarregarOutroCommand}"
                    Margin="0,8,0,0" />

            <Button Text="Voltar aos meus eventos"
                    Style="{StaticResource BotaoContorno}"
                    Command="{Binding IrParaEventosCommand}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
