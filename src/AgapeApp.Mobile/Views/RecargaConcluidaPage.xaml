<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             x:Class="AgapeApp.Mobile.Views.RecargaConcluidaPage"
             x:DataType="vm:RecargaConcluidaViewModel"
             Title="Recarga concluída"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,28,24,24" Spacing="14">

            <!-- Palco da comemoração: onda + círculo + confetes (adicionados no código) -->
            <Grid x:Name="Palco" HeightRequest="170">
                <Border x:Name="Onda"
                        WidthRequest="96"
                        HeightRequest="96"
                        StrokeThickness="3"
                        Stroke="{StaticResource Destaque}"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="Transparent"
                        Opacity="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                <Border x:Name="Circulo"
                        WidthRequest="96"
                        HeightRequest="96"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="{StaticResource Sucesso}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Label x:Name="Check"
                           Text="&#xf00c;" FontFamily="fa" FontSize="40"
                           TextColor="{StaticResource Superficie}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <VerticalStackLayout x:Name="Detalhes" Spacing="14">
                <Label Text="Recarga concluída!"
                       Style="{StaticResource TituloMedio}"
                       HorizontalTextAlignment="Center" />

                <Label x:Name="RotuloValor"
                       Text="{Binding TextoValor}"
                       Style="{StaticResource ValorGrande}"
                       TextColor="{StaticResource Sucesso}"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding TextoCartao}"
                       Style="{StaticResource LegendaPequena}"
                       HorizontalTextAlignment="Center"
                       Margin="0,0,0,8" />

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Novo saldo no evento"
                               Style="{StaticResource Legenda}"
                               VerticalOptions="Center" />
                        <Label x:Name="RotuloSaldo"
                               Grid.Column="1"
                               Text="{Binding TextoSaldo}"
                               Style="{StaticResource ValorMedio}"
                               TextColor="{StaticResource Sucesso}" />
                    </Grid>
                </Border>

                <Button Text="Recarregar outro cartão"
                        Style="{StaticResource BotaoDestaque}"
                        Command="{Binding RecarregarOutroCommand}"
                        Margin="0,8,0,0" />

                <Button Text="Voltar ao terminal"
                        Style="{StaticResource BotaoContorno}"
                        Command="{Binding IrParaOperacaoCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
