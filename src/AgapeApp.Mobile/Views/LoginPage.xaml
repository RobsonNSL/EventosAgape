<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgapeApp.Mobile.Views.LoginPage"
             Title="Entrar"
             BackgroundColor="#0B0F1A"
             Shell.NavBarIsVisible="False">

    <!-- Paleta local da tela de login: aqui o fundo é a foto da padroeira,
         então os cartões viram "vidro" translúcido e os textos ficam claros.
         O restante do app segue o modo claro do design system "Agape Direct". -->
    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="LoginTexto">#F8FAFC</Color>
            <Color x:Key="LoginTextoSecundario">#C7D2E4</Color>
            <Color x:Key="LoginTextoFraco">#8FA3BF</Color>
            <Color x:Key="LoginIcone">#93B4E8</Color>
            <Color x:Key="LoginLink">#BFDBFE</Color>
            <Color x:Key="LoginVidro">#D90B1220</Color>
            <Color x:Key="LoginCampo">#1FFFFFFF</Color>
            <Color x:Key="LoginBorda">#38FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <!-- Fundo: foto cobrindo a tela toda -->
        <Image Source="background.jpg" Aspect="AspectFill" />

        <!-- Véu escuro para manter títulos e cartões legíveis sobre a foto -->
        <BoxView>
            <BoxView.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#A60B0F1A" Offset="0" />
                    <GradientStop Color="#730B0F1A" Offset="0.45" />
                    <GradientStop Color="#B30B0F1A" Offset="1" />
                </LinearGradientBrush>
            </BoxView.Background>
        </BoxView>

        <ScrollView>
            <VerticalStackLayout Padding="24,44,24,24" Spacing="0">

                <!-- Marca: brasão da paróquia sobre base clara arredondada -->
                <Border HeightRequest="96"
                        WidthRequest="96"
                        HorizontalOptions="Center"
                        BackgroundColor="{StaticResource Superficie}"
                        Stroke="#4DFFFFFF"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 24"
                        Padding="5">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,6" Radius="12" Opacity="0.35" />
                    </Border.Shadow>
                    <Image Source="logo.jpg" Aspect="AspectFit" />
                </Border>

                <Label Text="AgapeApp"
                       Style="{StaticResource TituloGrande}"
                       TextColor="{StaticResource LoginTexto}"
                       HorizontalOptions="Center"
                       Margin="0,14,0,0" />
                <Label Text="Cartão pré-pago dos eventos da igreja"
                       Style="{StaticResource CorpoGrande}"
                       TextColor="{StaticResource LoginTextoSecundario}"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0" />

                <Border HorizontalOptions="Center"
                        Margin="0,16,0,0"
                        BackgroundColor="{StaticResource LoginCampo}"
                        Stroke="{StaticResource LoginBorda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        Padding="14,9">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="&#xf54e;" FontFamily="fa" FontSize="14"
                               TextColor="{StaticResource LoginIcone}" VerticalOptions="Center" />
                        <Label Text="Terminal do operador" Style="{StaticResource Legenda}"
                               TextColor="{StaticResource LoginTextoSecundario}" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Formulário -->
                <Border Margin="0,28,0,0"
                        BackgroundColor="{StaticResource LoginVidro}"
                        Stroke="{StaticResource LoginBorda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 16"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="#000000" Offset="0,8" Radius="16" Opacity="0.35" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="18">

                        <VerticalStackLayout Spacing="6">
                            <Label Text="E-mail" Style="{StaticResource Legenda}"
                                   TextColor="{StaticResource LoginTextoSecundario}" />
                            <Border Style="{StaticResource MolduraCampo}"
                                    BackgroundColor="{StaticResource LoginCampo}"
                                    Stroke="{StaticResource LoginBorda}">
                                <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                    <Label Text="&#xf0e0;" FontFamily="fa" FontSize="16"
                                           TextColor="{StaticResource LoginIcone}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding Email}"
                                           Keyboard="Email"
                                           Placeholder="voce@paroquia.com.br"
                                           TextColor="{StaticResource LoginTexto}"
                                           PlaceholderColor="{StaticResource LoginTextoFraco}"
                                           ReturnType="Next" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Senha" Style="{StaticResource Legenda}"
                                   TextColor="{StaticResource LoginTextoSecundario}" />
                            <Border Style="{StaticResource MolduraCampo}"
                                    BackgroundColor="{StaticResource LoginCampo}"
                                    Stroke="{StaticResource LoginBorda}">
                                <Grid ColumnDefinitions="24,*,40" ColumnSpacing="10">
                                    <Label Text="&#xf023;" FontFamily="fa" FontSize="16"
                                           TextColor="{StaticResource LoginIcone}" VerticalOptions="Center" />
                                    <Entry Grid.Column="1"
                                           Text="{Binding Senha}"
                                           IsPassword="{Binding SenhaEhSecreta}"
                                           Placeholder="Sua senha"
                                           TextColor="{StaticResource LoginTexto}"
                                           PlaceholderColor="{StaticResource LoginTextoFraco}"
                                           ReturnType="Go"
                                           ReturnCommand="{Binding EntrarCommand}" />
                                    <Label Grid.Column="2"
                                           Text="{Binding IconeOlho}"
                                           FontFamily="fa"
                                           FontSize="16"
                                           TextColor="{StaticResource LoginTextoSecundario}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding AlternarVisibilidadeSenhaCommand}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Grid>
                            </Border>
                        </VerticalStackLayout>

                        <!-- Erro -->
                        <Border IsVisible="{Binding TemErro}"
                                BackgroundColor="{StaticResource PerigoContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="12,10">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                                <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                                       TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                                <Label Grid.Column="1"
                                       Text="{Binding MensagemErro}"
                                       Style="{StaticResource Corpo}"
                                       TextColor="{StaticResource OnPerigoContainer}" />
                            </Grid>
                        </Border>

                        <!-- Entrar -->
                        <Grid>
                            <Button Text="Entrar"
                                    Command="{Binding EntrarCommand}"
                                    IsEnabled="{Binding NaoEstaCarregando}" />
                            <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                               IsRunning="{Binding EstaCarregando}"
                                               Color="{StaticResource Superficie}"
                                               WidthRequest="22"
                                               HeightRequest="22"
                                               HorizontalOptions="End"
                                               VerticalOptions="Center"
                                               Margin="0,0,18,0" />
                        </Grid>

                        <Button Text="Entrar com biometria"
                                Style="{StaticResource BotaoContorno}"
                                BackgroundColor="{StaticResource LoginCampo}"
                                TextColor="{StaticResource LoginTexto}"
                                BorderColor="{StaticResource LoginBorda}"
                                IsVisible="{Binding BiometriaDisponivel}"
                                Command="{Binding EntrarComBiometriaCommand}" />
                        <Label Text="A biometria fica disponível após o primeiro login neste aparelho."
                               Style="{StaticResource LegendaPequena}"
                               TextColor="{StaticResource LoginTextoFraco}"
                               IsVisible="{Binding SemBiometria}"
                               HorizontalTextAlignment="Center"
                               Margin="0,-8,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Esqueceu a senha? Procure um administrador do sistema."
                       Style="{StaticResource LegendaPequena}"
                       TextColor="{StaticResource LoginTextoSecundario}"
                       HorizontalTextAlignment="Center"
                       Margin="0,20,0,0" />

                <Button Text="Configurar endereço do servidor"
                        Style="{StaticResource BotaoTexto}"
                        TextColor="{StaticResource LoginLink}"
                        IsVisible="{Binding MostrarConfiguracaoServidor}"
                        Clicked="AoConfigurarServidor"
                        Margin="0,8,0,0" />

                <Label Text="AgapeApp v1.0 · Paróquia e quermesses"
                       Style="{StaticResource LegendaPequena}"
                       TextColor="{StaticResource LoginTextoFraco}"
                       HorizontalTextAlignment="Center"
                       Margin="0,4,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
