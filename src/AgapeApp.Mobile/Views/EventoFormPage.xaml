<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             xmlns:controles="clr-namespace:AgapeApp.Mobile.Controls"
             x:Class="AgapeApp.Mobile.Views.EventoFormPage"
             x:DataType="vm:EventoFormViewModel"
             Title="Evento"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="16">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <controles:BotaoVoltar Command="{Binding VoltarCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloMedio}" />
                    <Label Text="{Binding Subtitulo}" Style="{StaticResource LegendaPequena}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Nome do evento" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Text="&#xf073;" FontFamily="fa" FontSize="16"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Nome}"
                                       Placeholder="Ex.: Festa Junina 2026" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Começa em" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <DatePicker Date="{Binding DataInicio}"
                                        Format="dd/MM/yyyy"
                                        FontFamily="Inter"
                                        FontSize="16"
                                        TextColor="{StaticResource TextoPrimario}"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <Label Text="Termina em outro dia"
                               Style="{StaticResource CorpoGrande}"
                               VerticalOptions="Center" />
                        <Switch Grid.Column="1"
                                IsToggled="{Binding TerminaOutroDia}"
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding MostrarDataFim}">
                        <Label Text="Termina em" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <DatePicker Date="{Binding DataFim}"
                                        Format="dd/MM/yyyy"
                                        FontFamily="Inter"
                                        FontSize="16"
                                        TextColor="{StaticResource TextoPrimario}"
                                        VerticalOptions="Center" />
                        </Border>
                    </VerticalStackLayout>

                    <!-- Erro -->
                    <Border IsVisible="{Binding TemErro}"
                            BackgroundColor="{StaticResource PerigoContainer}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                            <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                                   TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MensagemErro}"
                                   Style="{StaticResource Corpo}"
                                   TextColor="{StaticResource OnPerigoContainer}" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Button Text="{Binding TextoBotao}" Command="{Binding SalvarCommand}" />
                        <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                           IsRunning="{Binding EstaCarregando}"
                                           Color="{StaticResource Superficie}"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,18,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Border BackgroundColor="{StaticResource SuperficieTint}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf05a;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Depois de criar o evento, abra os detalhes para cadastrar setores, vincular produtos e designar os operadores."
                           Style="{StaticResource LegendaPequena}" />
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
