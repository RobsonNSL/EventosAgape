<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AgapeApp.Mobile.Views.EventoProdutoFormPage"
             Title="Produto do evento"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="16">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Start"
                        Stroke="{StaticResource Borda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Superficie}">
                    <Label Text="&#xf060;" FontFamily="fa" FontSize="15"
                           TextColor="{StaticResource TextoPrimario}"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding Titulo}" Style="{StaticResource TituloMedio}" />
                    <Label Text="{Binding Subtitulo}" Style="{StaticResource LegendaPequena}" />
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="16">

                    <VerticalStackLayout Spacing="6">
                        <Label Text="Preço neste evento" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Text="&#xf155;" FontFamily="fa" FontSize="16"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Preco}"
                                       Keyboard="Numeric"
                                       Placeholder="Ex.: 7,50" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="Controlar estoque" Style="{StaticResource CorpoGrande}" />
                            <Label Text="O sistema avisa e bloqueia a venda quando acabar"
                                   Style="{StaticResource LegendaPequena}" />
                        </VerticalStackLayout>
                        <Switch Grid.Column="1"
                                IsToggled="{Binding ControlaEstoque}"
                                OnColor="{StaticResource Primary}"
                                VerticalOptions="Center" />
                    </Grid>

                    <VerticalStackLayout Spacing="6" IsVisible="{Binding MostrarQuantidade}">
                        <Label Text="Quantidade em estoque" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="24,*" ColumnSpacing="10">
                                <Label Text="&#xf1b2;" FontFamily="fa" FontSize="16"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding Quantidade}"
                                       Keyboard="Numeric"
                                       Placeholder="0" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Erro -->
                    <Border IsVisible="{Binding TemErro}"
                            BackgroundColor="{StaticResource PerigoContainer}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                            <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                                   TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding MensagemErro}"
                                   Style="{StaticResource Corpo}"
                                   TextColor="{StaticResource OnPerigoContainer}" />
                        </Grid>
                    </Border>

                    <Grid>
                        <Button Text="{Binding TextoBotao}" Command="{Binding SalvarCommand}" />
                        <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                           IsRunning="{Binding EstaCarregando}"
                                           Color="{StaticResource Superficie}"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           Margin="0,0,18,0" />
                    </Grid>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
