<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             xmlns:controles="clr-namespace:AgapeApp.Mobile.Controls"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.VendaPage"
             x:DataType="vm:VendaViewModel"
             Title="Venda"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabeçalho + saldo -->
        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,12" Spacing="12">

            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                <controles:BotaoVoltar Command="{Binding VoltarCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Vender no setor" Style="{StaticResource TituloMedio}" />
                    <Label Style="{StaticResource LegendaPequena}" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding EventoNome}" />
                                <Span Text=" · " />
                                <Span Text="{Binding SetorNome}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        Text="Limpar"
                        Style="{StaticResource BotaoTexto}"
                        Padding="8,0"
                        IsVisible="{Binding TemItens}"
                        Command="{Binding LimparCommand}"
                        VerticalOptions="Center" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Saldo do cartão" Style="{StaticResource LegendaPequena}" />
                        <Label Text="{Binding TextoSaldo}"
                               FontFamily="InterBold"
                               FontSize="22"
                               TextColor="{StaticResource Sucesso}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource Badge}"
                            BackgroundColor="{StaticResource PrimaryContainer}"
                            VerticalOptions="Center">
                        <Label Text="{Binding Cartao}"
                               Style="{StaticResource LegendaPequena}"
                               TextColor="{StaticResource OnPrimaryContainer}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Aviso de modo offline (catálogo salvo) -->
            <Border IsVisible="{Binding ModoOffline}"
                    BackgroundColor="{StaticResource DestaqueContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnDestaqueContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Sem conexão: mostrando o cardápio salvo neste aparelho. A venda só é confirmada com internet."
                           Style="{StaticResource LegendaPequena}"
                           TextColor="{StaticResource OnDestaqueContainer}" />
                </Grid>
            </Border>

            <!-- Erro -->
            <Border IsVisible="{Binding TemErro}"
                    BackgroundColor="{StaticResource PerigoContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensagemErro}"
                           Style="{StaticResource Corpo}"
                           TextColor="{StaticResource OnPerigoContainer}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Produtos do setor: toque no card soma 1 -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Produtos}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        Margin="20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,40" Spacing="10">
                    <Label Text="&#xf07a;" FontFamily="fa" FontSize="34"
                           TextColor="{StaticResource TextoMudo}"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum produto neste setor"
                           Style="{StaticResource SubtituloPequeno}"
                           HorizontalTextAlignment="Center" />
                    <Label Text="Peça ao administrador para marcar o que este setor vende."
                           Style="{StaticResource LegendaPequena}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ItemCarrinho">
                    <Border Style="{StaticResource Card}" Padding="14,12">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding TemQuantidade}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource Sucesso}" />
                                <Setter Property="BackgroundColor" Value="#F0FDF4" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <!-- Área do nome: um toque soma 1 (fica ao lado dos botões, não por baixo) -->
                            <Grid BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding AdicionarCommand, Source={RelativeSource AncestorType={x:Type vm:VendaViewModel}}, x:DataType=vm:VendaViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                                <Grid ColumnDefinitions="60,*" ColumnSpacing="12" InputTransparent="True" CascadeInputTransparent="True">
                                    <!-- Foto do produto (ícone enquanto carrega ou se não houver) -->
                                    <Border WidthRequest="60"
                                            HeightRequest="60"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 14"
                                            BackgroundColor="{StaticResource SucessoContainer}"
                                            VerticalOptions="Center">
                                        <Grid>
                                            <Label Text="&#xf2e7;" FontFamily="fa" FontSize="20"
                                                   IsVisible="{Binding SemImagem}"
                                                   TextColor="{StaticResource OnSucessoContainer}"
                                                   HorizontalOptions="Center" VerticalOptions="Center" />
                                            <Image Source="{Binding Imagem}"
                                                   IsVisible="{Binding TemImagem}"
                                                   Aspect="AspectFill" />
                                        </Grid>
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                        <Label Text="{Binding Nome}" Style="{StaticResource SubtituloPequeno}" />
                                        <Label Text="{Binding TextoPreco}" Style="{StaticResource LegendaPequena}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Grid>

                            <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                                <controles:BotaoIcone Glifo="&#xf068;"
                                                      CorIcone="{StaticResource Cinza}"
                                                      IsVisible="{Binding TemQuantidade}"
                                                      Command="{Binding DiminuirCommand, Source={RelativeSource AncestorType={x:Type vm:VendaViewModel}}, x:DataType=vm:VendaViewModel}"
                                                      CommandParameter="{Binding .}" />

                                <Label Text="{Binding TextoQuantidade}"
                                       IsVisible="{Binding TemQuantidade}"
                                       FontFamily="InterBold"
                                       FontSize="20"
                                       MinimumWidthRequest="26"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />

                                <controles:BotaoIcone Glifo="&#xf067;"
                                                      CorIcone="{StaticResource Superficie}"
                                                      BackgroundColor="{StaticResource Sucesso}"
                                                      Stroke="{StaticResource Sucesso}"
                                                      IsEnabled="{Binding AumentaHabilitado}"
                                                      Command="{Binding AumentarCommand, Source={RelativeSource AncestorType={x:Type vm:VendaViewModel}}, x:DataType=vm:VendaViewModel}"
                                                      CommandParameter="{Binding .}" />
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé com total e saldo que sobra -->
        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,20" Spacing="10"
                             BackgroundColor="{StaticResource Superficie}">
            <BoxView HeightRequest="1" Color="{StaticResource Borda}" />
            <Grid ColumnDefinitions="*,Auto">
                <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                    <Label Text="{Binding TextoItens}" Style="{StaticResource Legenda}" />
                    <Label Text="{Binding TextoRestante}"
                           Style="{StaticResource LegendaPequena}"
                           TextColor="{StaticResource OnSucessoContainer}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding SaldoInsuficiente}" Value="True">
                                <Setter Property="TextColor" Value="{StaticResource Perigo}" />
                                <Setter Property="FontFamily" Value="InterSemiBold" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </VerticalStackLayout>
                <Label x:Name="RotuloTotal" Grid.Column="1" Text="{Binding TextoTotal}" Style="{StaticResource ValorMedio}" VerticalOptions="Center" />
            </Grid>
            <Grid>
                <Button Text="{Binding TextoBotao}"
                        Style="{StaticResource BotaoSucesso}"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PodeConfirmar}" />
                <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                   IsRunning="{Binding EstaCarregando}"
                                   Color="{StaticResource Superficie}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,18,0" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
