<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.VendaPage"
             Title="Venda"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Cabeçalho + saldo -->
        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,12" Spacing="14">

            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Start"
                        Stroke="{StaticResource Borda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Superficie}">
                    <Label Text="&#xf060;" FontFamily="fa" FontSize="15"
                           TextColor="{StaticResource TextoPrimario}"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Vender no setor" Style="{StaticResource TituloMedio}" />
                    <Label Style="{StaticResource LegendaPequena}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding EventoNome}" />
                                <Span Text=" · " />
                                <Span Text="{Binding SetorNome}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Saldo do cartão" Style="{StaticResource LegendaPequena}" />
                        <Label Text="{Binding TextoSaldo}"
                               FontFamily="InterBold"
                               FontSize="20"
                               TextColor="{StaticResource Sucesso}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource Badge}"
                            BackgroundColor="{StaticResource PrimaryContainer}"
                            VerticalOptions="Center">
                        <Label Text="{Binding Cartao}"
                               Style="{StaticResource LegendaPequena}"
                               TextColor="{StaticResource OnPrimaryContainer}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Aviso de modo offline (catálogo salvo) -->
            <Border IsVisible="{Binding ModoOffline}"
                    BackgroundColor="{StaticResource DestaqueContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnDestaqueContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="Sem conexão: mostrando o cardápio salvo neste aparelho. A venda só é confirmada com internet."
                           Style="{StaticResource LegendaPequena}"
                           TextColor="{StaticResource OnDestaqueContainer}" />
                </Grid>
            </Border>

            <!-- Erro -->
            <Border IsVisible="{Binding TemErro}"
                    BackgroundColor="{StaticResource PerigoContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensagemErro}"
                           Style="{StaticResource Corpo}"
                           TextColor="{StaticResource OnPerigoContainer}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- Produtos do setor -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Produtos}"
                        SelectionMode="None"
                        VerticalScrollBarVisibility="Never"
                        Margin="20,0">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>
            <CollectionView.EmptyView>
                <VerticalStackLayout Padding="40,40" Spacing="10">
                    <Label Text="&#xf07a;" FontFamily="fa" FontSize="34"
                           TextColor="{StaticResource TextoMudo}"
                           HorizontalOptions="Center" />
                    <Label Text="Nenhum produto neste setor"
                           Style="{StaticResource SubtituloPequeno}"
                           HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ItemCarrinho">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="{Binding Nome}" Style="{StaticResource SubtituloPequeno}" />
                                <Label Text="{Binding TextoPreco}" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="12" VerticalOptions="Center">
                                <Border WidthRequest="36"
                                        HeightRequest="36"
                                        Stroke="{StaticResource Borda}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource Superficie}">
                                    <Label Text="&#xf068;" FontFamily="fa" FontSize="13"
                                           TextColor="{StaticResource Cinza}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.DiminuirCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>

                                <Label Text="{Binding Quantidade}"
                                       FontFamily="InterBold"
                                       FontSize="18"
                                       WidthRequest="24"
                                       HorizontalTextAlignment="Center"
                                       VerticalOptions="Center" />

                                <Border WidthRequest="36"
                                        HeightRequest="36"
                                        Stroke="{StaticResource Borda}"
                                        StrokeThickness="1.5"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource Superficie}">
                                    <Label Text="&#xf067;" FontFamily="fa" FontSize="13"
                                           TextColor="{StaticResource Primary}"
                                           HorizontalOptions="Center" VerticalOptions="Center">
                                        <Label.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.AumentarCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Label.GestureRecognizers>
                                    </Label>
                                </Border>
                            </HorizontalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Rodapé com total -->
        <VerticalStackLayout Grid.Row="2" Padding="20,12,20,20" Spacing="12"
                             BackgroundColor="{StaticResource Superficie}">
            <BoxView HeightRequest="1" Color="{StaticResource Borda}" />
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Total" Style="{StaticResource Legenda}" VerticalOptions="Center" />
                <Label Grid.Column="1" Text="{Binding TextoTotal}" Style="{StaticResource ValorMedio}" />
            </Grid>
            <Grid>
                <Button Text="{Binding TextoBotao}"
                        Style="{StaticResource BotaoSucesso}"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding TemItens}" />
                <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                   IsRunning="{Binding EstaCarregando}"
                                   Color="{StaticResource Superficie}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,18,0" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
