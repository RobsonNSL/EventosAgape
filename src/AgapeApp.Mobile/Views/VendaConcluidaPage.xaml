<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.VendaConcluidaPage"
             x:DataType="vm:VendaConcluidaViewModel"
             Title="Venda concluída"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="24,28,24,24" Spacing="14">

            <!-- Palco da comemoração: onda + círculo + confetes (adicionados no código) -->
            <Grid x:Name="Palco" HeightRequest="170">
                <Border x:Name="Onda"
                        WidthRequest="96"
                        HeightRequest="96"
                        StrokeThickness="3"
                        Stroke="{StaticResource Sucesso}"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="Transparent"
                        Opacity="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                <Border x:Name="Circulo"
                        WidthRequest="96"
                        HeightRequest="96"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 48"
                        BackgroundColor="{StaticResource Sucesso}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                    <Label x:Name="Check"
                           Text="&#xf00c;" FontFamily="fa" FontSize="40"
                           TextColor="{StaticResource Superficie}"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </Grid>

            <VerticalStackLayout x:Name="Detalhes" Spacing="14">
                <Label Text="Venda concluída!"
                       Style="{StaticResource TituloMedio}"
                       HorizontalTextAlignment="Center" />

                <Label Text="{Binding TextoCartao}"
                       Style="{StaticResource LegendaPequena}"
                       HorizontalTextAlignment="Center" />

                <Border Style="{StaticResource Card}" Margin="0,6,0,0">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Itens vendidos" Style="{StaticResource Legenda}" />

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Itens}" Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ItemVendaCartao">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding TextoQuantidade}"
                                               Style="{StaticResource Corpo}"
                                               TextColor="{StaticResource TextoSecundario}" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Nome}"
                                               Style="{StaticResource Corpo}" />
                                        <Label Grid.Column="2"
                                               Text="{Binding TextoSubtotal}"
                                               FontFamily="InterSemiBold"
                                               FontSize="14" />
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Borda}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Total da venda" Style="{StaticResource SubtituloPequeno}" VerticalOptions="Center" />
                            <Label x:Name="RotuloTotal"
                                   Grid.Column="1"
                                   Text="{Binding TextoTotal}"
                                   Style="{StaticResource ValorMedio}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Saldo restante no cartão"
                               Style="{StaticResource Legenda}"
                               VerticalOptions="Center" />
                        <Label x:Name="RotuloSaldo"
                               Grid.Column="1"
                               Text="{Binding TextoSaldo}"
                               Style="{StaticResource ValorMedio}"
                               TextColor="{StaticResource Sucesso}" />
                    </Grid>
                </Border>

                <Button Text="Atender próximo cliente"
                        Style="{StaticResource BotaoSucesso}"
                        Command="{Binding ProximoClienteCommand}"
                        Margin="0,8,0,0" />

                <Button Text="Voltar ao terminal"
                        Style="{StaticResource BotaoContorno}"
                        Command="{Binding IrParaOperacaoCommand}" />
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
