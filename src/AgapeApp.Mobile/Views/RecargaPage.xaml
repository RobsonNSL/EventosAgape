<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             xmlns:controles="clr-namespace:AgapeApp.Mobile.Controls"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.RecargaPage"
             x:DataType="vm:RecargaViewModel"
             Title="Recarregar"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20,24,20,16" Spacing="16">

                <!-- Cabeçalho -->
                <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                    <controles:BotaoVoltar Command="{Binding VoltarCommand}" />
                    <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                        <Label Text="Recarregar cartão" Style="{StaticResource TituloMedio}" />
                        <Label Style="{StaticResource LegendaPequena}">
                            <Label.FormattedText>
                                <FormattedString>
                                    <Span Text="{Binding EventoNome}" />
                                    <Span Text=" · " />
                                    <Span Text="{Binding SetorNome}" />
                                </FormattedString>
                            </Label.FormattedText>
                        </Label>
                    </VerticalStackLayout>
                </Grid>

                <!-- Saldo atual -->
                <Border Style="{StaticResource Card}">
                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Saldo atual no evento" Style="{StaticResource Legenda}" />
                            <Label Text="{Binding TextoSaldo}"
                                   Style="{StaticResource ValorGrande}"
                                   TextColor="{StaticResource Sucesso}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="1"
                                Style="{StaticResource Badge}"
                                BackgroundColor="{StaticResource PrimaryContainer}"
                                VerticalOptions="Start">
                            <Label Text="{Binding Cartao}"
                                   Style="{StaticResource LegendaPequena}"
                                   TextColor="{StaticResource OnPrimaryContainer}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Valor -->
                <Border Style="{StaticResource Card}">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Quanto o cliente pagou na maquininha?"
                               Style="{StaticResource SubtituloPequeno}" />

                        <!-- Valores rápidos: grade de 3 colunas, alvos grandes para o polegar -->
                        <FlexLayout Wrap="Wrap"
                                    Direction="Row"
                                    JustifyContent="SpaceBetween"
                                    BindableLayout.ItemsSource="{Binding Valores}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ValorChip">
                                    <Border Style="{StaticResource Chip}"
                                            FlexLayout.Basis="31%"
                                            HeightRequest="52"
                                            Padding="0"
                                            Margin="0,0,0,10">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding SelecionarValorCommand, Source={RelativeSource AncestorType={x:Type vm:RecargaViewModel}}, x:DataType=vm:RecargaViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding Selecionado}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{StaticResource Destaque}" />
                                                <Setter Property="Stroke" Value="{StaticResource Destaque}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Label Text="{Binding Titulo}"
                                               FontFamily="InterBold"
                                               FontSize="16"
                                               HorizontalOptions="Center"
                                               VerticalOptions="Center"
                                               TextColor="{StaticResource TextoPrimario}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>

                        <!-- Outro valor, digitado direto aqui -->
                        <Label Text="Outro valor" Style="{StaticResource Legenda}" />
                        <Border Style="{StaticResource MolduraCampo}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                <Label Text="R$"
                                       FontFamily="InterSemiBold"
                                       FontSize="18"
                                       TextColor="{StaticResource TextoSecundario}"
                                       VerticalOptions="Center" />
                                <Entry Grid.Column="1"
                                       Text="{Binding ValorDigitado}"
                                       Placeholder="0,00"
                                       Keyboard="Numeric"
                                       FontFamily="InterSemiBold"
                                       FontSize="18"
                                       MaxLength="9"
                                       ReturnType="Done" />
                            </Grid>
                        </Border>

                        <Label Text="{Binding TextoNovoSaldo}"
                               IsVisible="{Binding MostrarNovoSaldo}"
                               FontFamily="InterSemiBold"
                               FontSize="14"
                               TextColor="{StaticResource OnSucessoContainer}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Erro -->
                <Border IsVisible="{Binding TemErro}"
                        BackgroundColor="{StaticResource PerigoContainer}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12,10">
                    <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                        <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                               TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                        <Label Grid.Column="1"
                               Text="{Binding MensagemErro}"
                               Style="{StaticResource Corpo}"
                               TextColor="{StaticResource OnPerigoContainer}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Confirmar: sempre visível, acima do teclado e da rolagem -->
        <VerticalStackLayout Grid.Row="1"
                             Padding="20,12,20,20"
                             BackgroundColor="{StaticResource Superficie}">
            <Grid>
                <Button Text="{Binding TextoBotao}"
                        Style="{StaticResource BotaoDestaque}"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PodeConfirmar}" />
                <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                   IsRunning="{Binding EstaCarregando}"
                                   Color="{StaticResource TextoPrimario}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,18,0" />
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
