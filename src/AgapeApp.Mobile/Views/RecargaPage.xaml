<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.RecargaPage"
             Title="Recarregar"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,24,20,24" Spacing="16">

            <!-- Cabeçalho -->
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Start"
                        Stroke="{StaticResource Borda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Superficie}">
                    <Label Text="&#xf060;" FontFamily="fa" FontSize="15"
                           TextColor="{StaticResource TextoPrimario}"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Recarregar cartão" Style="{StaticResource TituloMedio}" />
                    <Label Style="{StaticResource LegendaPequena}">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding EventoNome}" />
                                <Span Text=" · " />
                                <Span Text="{Binding SetorNome}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Grid>

            <!-- Saldo atual -->
            <Border Style="{StaticResource Card}">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Saldo atual no evento" Style="{StaticResource Legenda}" />
                        <Label Text="{Binding TextoSaldo}"
                               Style="{StaticResource ValorGrande}"
                               TextColor="{StaticResource Sucesso}" />
                    </VerticalStackLayout>
                    <Border Grid.Column="1"
                            Style="{StaticResource Badge}"
                            BackgroundColor="{StaticResource PrimaryContainer}"
                            VerticalOptions="Start">
                        <Label Text="{Binding Cartao}"
                               Style="{StaticResource LegendaPequena}"
                               TextColor="{StaticResource OnPrimaryContainer}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Valor -->
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Quanto o cliente está entregando?"
                           Style="{StaticResource SubtituloPequeno}" />

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                BindableLayout.ItemsSource="{Binding Valores}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ValorChip">
                                <Border Style="{StaticResource Chip}"
                                        Padding="18,10"
                                        Margin="0,0,8,8">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding Selecionado}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                            <Setter Property="Stroke" Value="{StaticResource Primary}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label Text="{Binding Titulo}"
                                           FontFamily="InterSemiBold"
                                           TextColor="{StaticResource Cinza}">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding Selecionado}" Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource Superficie}" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.SelecionarValorCommand}"
                                            CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Button Text="Outro valor"
                            Style="{StaticResource BotaoContorno}"
                            Clicked="AoPedirOutroValor" />
                </VerticalStackLayout>
            </Border>

            <!-- Erro -->
            <Border IsVisible="{Binding TemErro}"
                    BackgroundColor="{StaticResource PerigoContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensagemErro}"
                           Style="{StaticResource Corpo}"
                           TextColor="{StaticResource OnPerigoContainer}" />
                </Grid>
            </Border>

            <!-- Confirmar -->
            <Grid>
                <Button Text="{Binding TextoBotao}"
                        Style="{StaticResource BotaoDestaque}"
                        Command="{Binding ConfirmarCommand}"
                        IsEnabled="{Binding PodeConfirmar}" />
                <ActivityIndicator IsVisible="{Binding EstaCarregando}"
                                   IsRunning="{Binding EstaCarregando}"
                                   Color="{StaticResource TextoPrimario}"
                                   WidthRequest="22"
                                   HeightRequest="22"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center"
                                   Margin="0,0,18,0" />
            </Grid>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
