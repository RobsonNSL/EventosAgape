<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.AuditoriaPage"
             Title="Auditoria"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,12" Spacing="6">
            <Grid ColumnDefinitions="44,*" ColumnSpacing="12">
                <Border WidthRequest="40"
                        HeightRequest="40"
                        VerticalOptions="Start"
                        Stroke="{StaticResource Borda}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource Superficie}">
                    <Label Text="&#xf060;" FontFamily="fa" FontSize="15"
                           TextColor="{StaticResource TextoPrimario}"
                           HorizontalOptions="Center" VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding VoltarCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Auditoria" Style="{StaticResource TituloMedio}" />
                    <Label Text="{Binding EventoNome}"
                           Style="{StaticResource LegendaPequena}"
                           LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Grid>
            <Label Text="{Binding TextoTotal}" Style="{StaticResource LegendaPequena}" Margin="56,0,0,0" />

            <!-- Erro -->
            <Border IsVisible="{Binding TemErro}"
                    BackgroundColor="{StaticResource PerigoContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensagemErro}"
                           Style="{StaticResource Corpo}"
                           TextColor="{StaticResource OnPerigoContainer}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     Command="{Binding AtualizarCommand}"
                     IsRefreshing="{Binding EstaCarregando}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Registros}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never"
                            Margin="20,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,50" Spacing="10">
                        <Label Text="&#xf46d;" FontFamily="fa" FontSize="34"
                               TextColor="{StaticResource TextoMudo}"
                               HorizontalOptions="Center" />
                        <Label Text="Nenhum registro ainda"
                               Style="{StaticResource SubtituloPequeno}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Cada recarga, venda ou ajuste no evento aparece aqui, com autor e aparelho."
                               Style="{StaticResource Corpo}"
                               TextColor="{StaticResource TextoSecundario}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:LogAuditoriaItem">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid ColumnDefinitions="38,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="36" HeightRequest="36"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{Binding Fundo}"
                                        VerticalOptions="Start">
                                    <Label Text="{Binding Icone}"
                                           FontFamily="fa"
                                           FontSize="14"
                                           TextColor="{Binding Cor}"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>

                                <VerticalStackLayout Grid.Column="1" Spacing="3">
                                    <Label Text="{Binding AcaoTexto}" Style="{StaticResource SubtituloPequeno}" />
                                    <Label Text="{Binding UsuarioNome}"
                                           Style="{StaticResource Corpo}"
                                           TextColor="{StaticResource TextoSecundario}" />
                                    <HorizontalStackLayout Spacing="5" IsVisible="{Binding TemDispositivo}">
                                        <Label Text="&#xf3ce;" FontFamily="fa" FontSize="11"
                                               TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                        <Label Text="{Binding Dispositivo}"
                                               Style="{StaticResource LegendaPequena}"
                                               FontSize="11"
                                               LineBreakMode="TailTruncation" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <Label Grid.Column="2"
                                       Text="{Binding DataTexto}"
                                       Style="{StaticResource LegendaPequena}"
                                       FontSize="11"
                                       VerticalOptions="Start" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,12,0,24">
                        <Button Text="{Binding TextoCarregarMais}"
                                Style="{StaticResource BotaoContorno}"
                                IsVisible="{Binding TemMais}"
                                Command="{Binding CarregarMaisCommand}" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
