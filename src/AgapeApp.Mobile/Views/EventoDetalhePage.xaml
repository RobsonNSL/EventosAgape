<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             xmlns:controles="clr-namespace:AgapeApp.Mobile.Controls"
             x:Class="AgapeApp.Mobile.Views.EventoDetalhePage"
             x:DataType="vm:EventoDetalheViewModel"
             Title="Evento"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <!-- Cabeçalho -->
        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,12" Spacing="12">
            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                <controles:BotaoVoltar Command="{Binding VoltarCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label Text="{Binding EventoNome}"
                           Style="{StaticResource TituloMedio}"
                           LineBreakMode="TailTruncation" />
                    <Label Text="{Binding DataTexto}" Style="{StaticResource LegendaPequena}" />
                </VerticalStackLayout>
                <Border Grid.Column="2"
                        Style="{StaticResource Badge}"
                        BackgroundColor="{Binding SituacaoFundo}"
                        VerticalOptions="Center">
                    <Label Text="{Binding SituacaoTexto}"
                           Style="{StaticResource LegendaPequena}"
                           FontSize="11"
                           TextColor="{Binding SituacaoCor}" />
                </Border>
            </Grid>

            <!-- Erro -->
            <Border IsVisible="{Binding TemErro}"
                    BackgroundColor="{StaticResource PerigoContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensagemErro}"
                           Style="{StaticResource Corpo}"
                           TextColor="{StaticResource OnPerigoContainer}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     Command="{Binding AtualizarCommand}"
                     IsRefreshing="{Binding EstaCarregando, Mode=OneWay}"
                     RefreshColor="{StaticResource Primary}">
            <ScrollView>
                <VerticalStackLayout Padding="20,0,20,28" Spacing="20">

                    <!-- Resumo em números -->
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                        <Border Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ContagemSetores}" Style="{StaticResource ValorMedio}" />
                                <Label Text="Setores" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ContagemProdutos}" Style="{StaticResource ValorMedio}" />
                                <Label Text="Produtos" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ContagemOperadores}" Style="{StaticResource ValorMedio}" />
                                <Label Text="Operadores" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <!-- Ações do evento -->
                    <VerticalStackLayout Spacing="10">
                        <Button Text="{Binding TextoAbrirEncerrar}"
                                IsVisible="{Binding PodeAbrirOuEncerrar}"
                                Command="{Binding AbrirEncerrarCommand}">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding EstaAberto}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Perigo}" />
                                </DataTrigger>
                                <DataTrigger TargetType="Button" Binding="{Binding EstaAberto}" Value="False">
                                    <Setter Property="BackgroundColor" Value="{StaticResource Sucesso}" />
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Text="Editar dados"
                                    Style="{StaticResource BotaoContorno}"
                                    HeightRequest="46"
                                    FontSize="14"
                                    Command="{Binding EditarCommand}" />
                            <Button Grid.Column="1"
                                    Text="Dashboard"
                                    Style="{StaticResource BotaoContorno}"
                                    HeightRequest="46"
                                    FontSize="14"
                                    Command="{Binding AbrirDashboardCommand}" />
                        </Grid>
                    </VerticalStackLayout>

                    <!-- Setores -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Setores" Style="{StaticResource SubtituloPequeno}" />
                                <Label Text="Onde o evento vende" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="+ Novo"
                                    Style="{StaticResource BotaoContorno}"
                                    HeightRequest="38"
                                    Padding="14,0"
                                    FontSize="13"
                                    VerticalOptions="Center"
                                    Command="{Binding NovoSetorCommand}" />
                        </Grid>

                        <Border IsVisible="{Binding SemSetores}"
                                BackgroundColor="{StaticResource CinzaContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14">
                            <Label Text="Nenhum setor ainda. Crie o primeiro (ex.: Pastel, Bebidas)."
                                   Style="{StaticResource LegendaPequena}" />
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Setores}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SetorItem">
                                    <Border Style="{StaticResource Card}" Padding="14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding AcoesSetorCommand, Source={RelativeSource AncestorType={x:Type vm:EventoDetalheViewModel}}, x:DataType=vm:EventoDetalheViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="40,*,20" ColumnSpacing="12">
                                            <Border WidthRequest="38"
                                                    HeightRequest="38"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 11"
                                                    BackgroundColor="{StaticResource DestaqueContainer}"
                                                    VerticalOptions="Center">
                                                <Label Text="&#xf54e;" FontFamily="fa" FontSize="14"
                                                       TextColor="{StaticResource OnDestaqueContainer}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding Nome}"
                                                       Style="{StaticResource SubtituloPequeno}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding Resumo}"
                                                       Style="{StaticResource LegendaPequena}">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding SemOperador}" Value="True">
                                                            <Setter Property="TextColor" Value="{StaticResource OnDestaqueContainer}" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </VerticalStackLayout>
                                            <Label Grid.Column="2" Text="&#xf142;" FontFamily="fa" FontSize="15"
                                                   TextColor="{StaticResource TextoMudo}"
                                                   HorizontalOptions="End" VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Produtos do evento -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Produtos do evento" Style="{StaticResource SubtituloPequeno}" />
                                <Label Text="Preço praticado e estoque de cada item" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="+ Vincular"
                                    Style="{StaticResource BotaoContorno}"
                                    HeightRequest="38"
                                    Padding="14,0"
                                    FontSize="13"
                                    VerticalOptions="Center"
                                    Command="{Binding VincularProdutoCommand}" />
                        </Grid>

                        <Border IsVisible="{Binding SemProdutos}"
                                BackgroundColor="{StaticResource CinzaContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14">
                            <Label Text="Nenhum produto vinculado. Vincule os itens que o evento vende."
                                   Style="{StaticResource LegendaPequena}" />
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Produtos}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:EventoProdutoItem">
                                    <Border Style="{StaticResource Card}" Padding="14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding AcoesProdutoCommand, Source={RelativeSource AncestorType={x:Type vm:EventoDetalheViewModel}}, x:DataType=vm:EventoDetalheViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="46,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="44"
                                                    HeightRequest="44"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{StaticResource SucessoContainer}"
                                                    VerticalOptions="Center">
                                                <Grid>
                                                    <Label Text="&#xf02b;" FontFamily="fa" FontSize="14"
                                                           IsVisible="{Binding SemImagem}"
                                                           TextColor="{StaticResource OnSucessoContainer}"
                                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                                    <Image Source="{Binding Imagem}"
                                                           IsVisible="{Binding TemImagem}"
                                                           Aspect="AspectFill" />
                                                </Grid>
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding ProdutoNome}"
                                                       Style="{StaticResource SubtituloPequeno}"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding TextoPreco}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource Sucesso}" />
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource Badge}"
                                                    BackgroundColor="{Binding EstoqueFundo}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding TextoEstoqueCurto}"
                                                       Style="{StaticResource LegendaPequena}"
                                                       FontSize="11"
                                                       TextColor="{Binding EstoqueCor}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- Operadores -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                                <Label Text="Operadores" Style="{StaticResource SubtituloPequeno}" />
                                <Label Text="Quem opera cada setor" Style="{StaticResource LegendaPequena}" />
                            </VerticalStackLayout>
                            <Button Grid.Column="1"
                                    Text="+ Designar"
                                    Style="{StaticResource BotaoContorno}"
                                    HeightRequest="38"
                                    Padding="14,0"
                                    FontSize="13"
                                    VerticalOptions="Center"
                                    Command="{Binding DesignarOperadorCommand}" />
                        </Grid>

                        <Border IsVisible="{Binding SemOperadores}"
                                BackgroundColor="{StaticResource CinzaContainer}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                Padding="14">
                            <Label Text="Nenhum operador designado. Sem operador liberado o setor não vende."
                                   Style="{StaticResource LegendaPequena}" />
                        </Border>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Operadores}" Spacing="10">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OperadorItem">
                                    <Border Style="{StaticResource Card}" Padding="14">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding AcoesOperadorCommand, Source={RelativeSource AncestorType={x:Type vm:EventoDetalheViewModel}}, x:DataType=vm:EventoDetalheViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="12">
                                            <Border WidthRequest="38"
                                                    HeightRequest="38"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 19"
                                                    BackgroundColor="{StaticResource PrimaryContainer}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding Iniciais}"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource OnPrimaryContainer}"
                                                       HorizontalOptions="Center" VerticalOptions="Center" />
                                            </Border>
                                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                                <Label Text="{Binding UsuarioNome}"
                                                       Style="{StaticResource SubtituloPequeno}"
                                                       LineBreakMode="TailTruncation" />
                                                <HorizontalStackLayout Spacing="5">
                                                    <Label Text="&#xf54e;" FontFamily="fa" FontSize="11"
                                                           TextColor="{StaticResource TextoSecundario}" VerticalOptions="Center" />
                                                    <Label Text="{Binding SetorNome}"
                                                           Style="{StaticResource LegendaPequena}" />
                                                </HorizontalStackLayout>
                                            </VerticalStackLayout>
                                            <Border Grid.Column="2"
                                                    Style="{StaticResource Badge}"
                                                    BackgroundColor="{Binding SituacaoFundo}"
                                                    VerticalOptions="Center">
                                                <Label Text="{Binding TextoSituacao}"
                                                       Style="{StaticResource LegendaPequena}"
                                                       FontSize="11"
                                                       TextColor="{Binding SituacaoCor}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <Border BackgroundColor="{StaticResource SuperficieTint}"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            Padding="12,10">
                        <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                            <Label Text="&#xf05a;" FontFamily="fa" FontSize="14"
                                   TextColor="{StaticResource Primary}" VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Text="Toque em um setor para escolher o que ele vende ou designar operadores; em um produto para preço e estoque; em um operador para trocar de setor ou bloquear."
                                   Style="{StaticResource LegendaPequena}" />
                        </Grid>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
