<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:AgapeApp.Mobile.ViewModels"
             xmlns:controles="clr-namespace:AgapeApp.Mobile.Controls"
             xmlns:models="clr-namespace:AgapeApp.Mobile.Models"
             x:Class="AgapeApp.Mobile.Views.ProdutosPage"
             x:DataType="vm:ProdutosViewModel"
             Title="Produtos"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <VerticalStackLayout Grid.Row="0" Padding="20,24,20,12" Spacing="12">
            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12">
                <controles:BotaoVoltar Command="{Binding VoltarCommand}" />
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label Text="Produtos" Style="{StaticResource TituloMedio}" />
                    <Label Text="O que o evento pode vender" Style="{StaticResource LegendaPequena}" />
                </VerticalStackLayout>
                <Button Grid.Column="2"
                        Text="Novo"
                        Style="{StaticResource BotaoContorno}"
                        HeightRequest="40"
                        Padding="14,0"
                        FontSize="13"
                        VerticalOptions="Center"
                        Command="{Binding NovoCommand}" />
            </Grid>

            <!-- Busca -->
            <Border Style="{StaticResource MolduraCampo}" HeightRequest="48">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf002;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                    <Entry Grid.Column="1"
                           Text="{Binding Busca}"
                           Placeholder="Buscar produto"
                           FontSize="14" />
                </Grid>
            </Border>

            <!-- Erro -->
            <Border IsVisible="{Binding TemErro}"
                    BackgroundColor="{StaticResource PerigoContainer}"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,10">
                <Grid ColumnDefinitions="20,*" ColumnSpacing="8">
                    <Label Text="&#xf071;" FontFamily="fa" FontSize="14"
                           TextColor="{StaticResource OnPerigoContainer}" VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding MensagemErro}"
                           Style="{StaticResource Corpo}"
                           TextColor="{StaticResource OnPerigoContainer}" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <RefreshView Grid.Row="1"
                     Command="{Binding AtualizarCommand}"
                     IsRefreshing="{Binding EstaCarregando, Mode=OneWay}"
                     RefreshColor="{StaticResource Primary}">
            <CollectionView ItemsSource="{Binding Produtos}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never"
                            Margin="20,0">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="40,50" Spacing="10">
                        <Label Text="&#xf1b2;" FontFamily="fa" FontSize="34"
                               TextColor="{StaticResource TextoMudo}"
                               HorizontalOptions="Center" />
                        <Label Text="Nenhum produto cadastrado"
                               Style="{StaticResource SubtituloPequeno}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Toque em Novo para cadastrar o primeiro item do catálogo."
                               Style="{StaticResource Corpo}"
                               TextColor="{StaticResource TextoSecundario}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ProdutoItem">
                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid ColumnDefinitions="48,*,Auto,20" ColumnSpacing="12">
                                <Border WidthRequest="44"
                                        HeightRequest="44"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource SucessoContainer}"
                                        VerticalOptions="Center">
                                    <Grid>
                                        <Label Text="&#xf1b2;" FontFamily="fa" FontSize="14"
                                               IsVisible="{Binding SemImagem}"
                                               TextColor="{StaticResource OnSucessoContainer}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Image Source="{Binding Imagem}"
                                               IsVisible="{Binding TemImagem}"
                                               Aspect="AspectFill" />
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Nome}"
                                           Style="{StaticResource SubtituloPequeno}"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding TextoPreco}"
                                           Style="{StaticResource LegendaPequena}"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                                <Border Grid.Column="2"
                                        Style="{StaticResource Badge}"
                                        BackgroundColor="{Binding SituacaoFundo}"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding TextoSituacao}"
                                           Style="{StaticResource LegendaPequena}"
                                           FontSize="11"
                                           TextColor="{Binding SituacaoCor}" />
                                </Border>
                                <Label Grid.Column="3" Text="&#xf054;" FontFamily="fa" FontSize="13"
                                       TextColor="{StaticResource TextoMudo}" VerticalOptions="Center" />
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding AcoesCommand, Source={RelativeSource AncestorType={x:Type vm:ProdutosViewModel}}, x:DataType=vm:ProdutosViewModel}"
                                        CommandParameter="{Binding .}" />
                                </Border.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
